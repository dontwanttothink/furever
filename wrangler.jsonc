{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fureverhome",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-07-13",
	"r2_buckets": [
		{ "bucket_name": "furever-photographic", "binding": "user_photography" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "furever-db",
			"database_id": "3b6e49f0-0ace-459c-bc43-2c7aba1e8dbd"
		}
	]
}
