{
	"name": "furever",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": ". ./shell/bun_verify.sh",
		"prepreview": ". ./shell/bun_verify.sh",
		"dev": "vite dev",
		"build": "vite build && cp package.json build/package.json && cp bun.lock build/bun.lock",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && tsc && eslint . && stylelint '**/*.css'",
		"clean": "rimraf node_modules"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250712.0",
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.31.0",
		"@sveltejs/adapter-cloudflare": "^7.0.5",
		"@sveltejs/kit": "^2.22.5",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@typescript/lib-dom": "npm:@types/web",
		"drizzle-kit": "^0.30.6",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.10.1",
		"globals": "^16.3.0",
		"jiti": "^2.4.2",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"rimraf": "^6.0.1",
		"stylelint": "^16.21.1",
		"stylelint-config-standard": "^37.0.0",
		"svelte": "^5.35.6",
		"svelte-check": "^4.2.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.36.0",
		"typescript-svelte-plugin": "^0.3.48",
		"vite": "^6.3.5"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.6",
		"@jsquash/jpeg": "^1.6.0",
		"@simplewebauthn/browser": "^13.1.2",
		"@simplewebauthn/server": "^13.1.2",
		"argon2": "^0.41.1",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^0.41.0",
		"temporal-polyfill": "^0.3.0"
	}
}
